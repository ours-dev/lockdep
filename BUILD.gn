import("//build/cpp/cpp_interface.gni")

# lockdep is header-only.  `LockContext` is small enough to inline, and the
# lock class state has to be an inline variable anyway so every translation
# unit agrees on the address that identifies a class.
#
# The dependency-graph walk in ValidatorLockClassState is the first thing that
# will need a source file; add a compiled target when it lands.
cpp_interface("lockdep") {
  public = [
    "include/lockdep/config.hpp",
    "include/lockdep/guard.hpp",
    "include/lockdep/lock_class_state.hpp",
    "include/lockdep/lock_class.hpp",
    "include/lockdep/lock_context.hpp",
    "include/lockdep/lock_policy.hpp",
    "include/lockdep/lock_traits.hpp",
    "include/lockdep/runtime_api.hpp",
    "include/lockdep/state_saver.hpp",
    "include/lockdep/thread_lock_state.hpp",
    "include/lockdep/types.hpp",
  ]

  public_deps = [ "//system/lib/ustl:headers" ]
}
